[{"n":101,"w":"last","p":"adjective","bn":"শেষ; গত","ex":"This is the last bus tonight.","exbn":"আজ রাতের এটাই শেষ বাস।","d":"coming after all the others; final"},{"n":102,"w":"child","p":"noun","bn":"শিশু, বাচ্চা","ex":"The child is sleeping.","exbn":"বাচ্চাটা ঘুমাচ্ছে।","d":"a young boy or girl"},{"n":103,"w":"tell","p":"verb","bn":"বলা (কাউকে)","ex":"Please tell me the truth.","exbn":"দয়া করে আমাকে সত্যিটা বলো।","d":"to give information to someone"},{"n":104,"w":"really","p":"adverb","bn":"সত্যিই; খুব","ex":"I really like this song.","exbn":"আমি সত্যিই এই গানটা পছন্দ করি।","d":"very much; truly"},{"n":105,"w":"call","p":"verb","bn":"ফোন করা; ডাকা","ex":"I will call you tonight.","exbn":"আমি আজ রাতে তোমাকে ফোন করব।","d":"to phone someone"},{"n":106,"w":"before","p":"preposition","bn":"আগে","ex":"Wash your hands before dinner.","exbn":"রাতের খাবারের আগে হাত ধুয়ে নাও।","d":"earlier than something"},{"n":107,"w":"company","p":"noun","bn":"কোম্পানি, প্রতিষ্ঠান","ex":"She works for a big company.","exbn":"সে একটা বড় কোম্পানিতে কাজ করে।","d":"a business that sells goods or services"},{"n":108,"w":"through","p":"preposition","bn":"মধ্য দিয়ে, ভেতর দিয়ে","ex":"We walked through the park.","exbn":"আমরা পার্কের মধ্য দিয়ে হেঁটে গেলাম।","d":"from one side to the other"},{"n":109,"w":"down","p":"adverb","bn":"নিচে","ex":"Please sit down.","exbn":"দয়া করে বসুন।","d":"towards a lower position"},{"n":110,"w":"show","p":"verb","bn":"দেখানো","ex":"Can you show me the way?","exbn":"আপনি কি আমাকে রাস্তাটা দেখাতে পারবেন?","d":"to let someone see or learn something"},{"n":111,"w":"life","p":"noun","bn":"জীবন","ex":"Life is short.","exbn":"জীবন ছোট।","d":"the time a person is alive"},{"n":112,"w":"man","p":"noun","bn":"পুরুষ, লোক","ex":"A man is waiting outside.","exbn":"একজন লোক বাইরে অপেক্ষা করছে।","d":"an adult male person"},{"n":113,"w":"change","p":"verb","bn":"বদলানো, পরিবর্তন করা","ex":"I want to change my phone number.","exbn":"আমি আমার ফোন নম্বর বদলাতে চাই।","d":"to make 
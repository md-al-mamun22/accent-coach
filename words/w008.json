[{"n":701,"w":"guy","p":"noun","bn":"লোক, ছেলে (কথ্য)","ex":"He is a nice guy.","exbn":"সে একজন ভালো ছেলে।","d":"a man (informal)"},{"n":702,"w":"function","p":"noun","bn":"কাজ, ভূমিকা; অনুষ্ঠান","ex":"What is the function of this button?","exbn":"এই বাটনটার কাজ কী?","d":"what something is used for"},{"n":703,"w":"yesterday","p":"adverb","bn":"গতকাল","ex":"I met him yesterday.","exbn":"আমি গতকাল তার সাথে দেখা করেছি।","d":"the day before today"},{"n":704,"w":"image","p":"noun","bn":"ছবি, প্রতিচ্ছবি","ex":"Upload an image of your ID.","exbn":"তোমার আইডি কার্ডের একটা ছবি আপলোড করো।","d":"a picture or photo"},{"n":705,"w":"size","p":"noun","bn":"মাপ, সাইজ","ex":"What size are your shoes?","exbn":"তোমার জুতার সাইজ কত?","d":"how big or small something is"},{"n":706,"w":"behavior","p":"noun","bn":"আচরণ","ex":"His behavior was very rude.","exbn":"তার আচরণ খুব অভদ্র ছিল।","d":"the way someone acts"},{"n":707,"w":"addition","p":"noun","bn":"যোগ; (in addition) এছাড়াও","ex":"In addition, we offer free delivery.","exbn":"এছাড়াও আমরা ফ্রি ডেলিভারি দিই।","d":"in addition = also"},{"n":708,"w":"determine","p":"verb","bn":"নির্ধারণ করা","ex":"The test will determine your level.","exbn":"টেস্টটা তোমার লেভেল নির্ধারণ করবে।","d":"to find out or decide"},{"n":709,"w":"station","p":"noun","bn":"স্টেশন","ex":"Where is the bus station?","exbn":"বাস স্টেশনটা কোথায়?","d":"a place where trains or buses stop"},{"n":710,"w":"population","p":"noun","bn":"জনসংখ্যা","ex":"Dhaka has a large population.","exbn":"ঢাকার জনসংখ্যা অনেক বেশি।","d":"the number of people living in a place"},{"n":711,"w":"fail","p":"verb","bn":"ব্যর্থ হওয়া, ফেল করা","ex":"Don't be afraid to fail.","exbn":"ব্যর্থ হতে ভয় পেয়ো না।","d":"to not succeed"},{"n":712,"w":"environment","p":"noun","bn":"পরিবেশ","ex":"We must protect the environment.","exbn":"আমাদের পরিবেশ রক্ষা করতে হবে।","d":"the air, water and land around us"},{"n":713,"w":"production","p":"noun","bn":"উৎপাদন","ex":"Rice production was high this year.","exbn":"এ বছর ধানের উৎপাদন বেশি হয়েছে।","d":"the amount of something that is made or grown"},{"n":714,"w":"contract","p":"noun","bn":"চুক্তিপত্র","ex":"Read the contract before you sign.","exbn":"সই করার আগে চুক্তিপত্রটা পড়ে নাও।","d":"a written legal agreement"},{"n":715,"w":"player","p":"noun","bn":"খেলোয়াড়","ex":"He is a good cricket player.","exbn":"সে একজন ভালো ক্রিকেট খেলোয়াড়।","d":"a person who plays a sport or game"},{"n":716,"w":"comment","p":"noun","bn":"মন্তব্য","ex":"Leave a comment below.","exbn":"নিচে একটা মন্তব্য করুন।","d":"something you say or write about a topic"},{"n":717,"w":"enter","p":"verb","bn":"প্রবেশ করা; লেখা (তথ্য)","ex":"Enter your password.","exbn":"তোমার পাসওয়ার্ড লেখো।","d":"to type information into a computer"},{"n":718,"w":"occur","p":"verb","bn":"ঘটা","ex":"The accident occurred at night.","exbn":"দুর্ঘটনাটা রাতে ঘটেছিল।","d":"to happen"},{"n":719,"w":"alone","p":"adverb","bn":"একা","ex":"She lives alone.","exbn":"সে একা থাকে।","d":"without other people"},{"n":720,"w":"significant","p":"adjective","bn":"উল্লেখযোগ্য, গুরুত্বপূর্ণ","ex":"There was a significant change.","exbn":"একটা উল্লেখযোগ্য পরিবর্তন হয়েছে।","d":"large or important"},{"n":721,"w":"drug","p":"noun","bn":"ওষুধ; মাদক","ex":"This drug helps with pain.","exbn":"এই ওষুধটা ব্যথা কমায়।","d":"a medicine"},{"n":722,"w":"wall","p":"noun","bn":"দেয়াল","ex":"There is a clock on the wall.","exbn":"দেয়ালে একটা ঘড়ি আছে।","d":"one of the sides of a room or building"},{"n":723,"w":"series","p":"noun","bn":"ধারাবাহিক, সিরিজ","ex":"I am watching a new TV series.","exbn":"আমি একটা নতুন টিভি সিরিজ দেখছি।","d":"a set of TV shows with the same characters"},{"n":724,"w":"direct","p":"adjective","bn":"সরাসরি","ex":"Is there a direct flight to London?","exbn":"লন্ডনে কি সরাসরি ফ্লাইট আছে?","d":"going straight without stopping"},{"n":725,"w":"success","p":"noun","bn":"সাফল্য","ex":"Hard work is the key to success.","exbn":"কঠোর পরিশ্রমই সাফল্যের চাবিকাঠি।","d":"getting the result you wanted"},{"n":726,"w":"tomorrow","p":"adverb","bn":"আগামীকাল","ex":"See you tomorrow.","exbn":"কাল দেখা হবে।","d":"the day after today"},{"n":727,"w":"director","p":"noun","bn":"পরিচালক","ex":"He is the director of the company.","exbn":"তিনি কোম্পানির পরিচালক।","d":"a person who manages a company"},{"n":728,"w":"clearly","p":"adverb","bn":"স্পষ্টভাবে","ex":"Please speak clearly.","exbn":"দয়া করে স্পষ্ট করে বলুন।","d":"in a way that is easy to hear or understand"},{"n":729,"w":"lack","p":"noun","bn":"অভাব","ex":"He failed because of a lack of practice.","exbn":"অনুশীলনের অভাবে সে ফেল করেছে।","d":"not having enough of something"},{"n":730,"w":"review","p":"noun","bn":"রিভিউ, পর্যালোচনা","ex":"I read the reviews before buying.","exbn":"কেনার আগে আমি রিভিউগুলো পড়ি।","d":"an opinion about a product, film or book"},{"n":731,"w":"depend","p":"verb","bn":"নির্ভর করা","ex":"It depends on the weather.","exbn":"এটা আবহাওয়ার উপর নির্ভর করে।","d":"it depends = it changes because of something"},{"n":732,"w":"race","p":"noun","bn":"দৌড় প্রতিযোগিতা","ex":"He won the race.","exbn":"সে দৌড়ে প্রথম হয়েছে।","d":"a competition to see who is fastest"},{"n":733,"w":"recognize","p":"verb","bn":"চিনতে পারা","ex":"I didn't recognize you!","exbn":"আমি তো তোমাকে চিনতেই পারিনি!","d":"to know who someone is when you see them"},{"n":734,"w":"window","p":"noun","bn":"জানালা","ex":"Open the window, please.","exbn":"দয়া করে জানালাটা খোলো।","d":"an opening in a wall with glass"},{"n":735,"w":"purpose","p":"noun","bn":"উদ্দেশ্য","ex":"What is the purpose of your visit?","exbn":"আপনার আসার উদ্দেশ্য কী?","d":"the reason for doing something"},{"n":736,"w":"department","p":"noun","bn":"বিভাগ","ex":"She works in the sales department.","exbn":"সে সেলস বিভাগে কাজ করে।","d":"one part of a company or organisation"},{"n":737,"w":"gain","p":"verb","bn":"অর্জন করা; বাড়া","ex":"I gained a lot of experience.","exbn":"আমি অনেক অভিজ্ঞতা অর্জন করেছি।","d":"to get something useful"},{"n":738,"w":"tree","p":"noun","bn":"গাছ","ex":"There is a mango tree in our yard.","exbn":"আমাদের উঠানে একটা আম গাছ আছে।","d":"a tall plant with a trunk and branches"},{"n":739,"w":"college","p":"noun","bn":"কলেজ","ex":"My sister goes to college.","exbn":"আমার বোন কলেজে পড়ে।","d":"a place for study after school"},{"n":740,"w":"argue","p":"verb","bn":"তর্ক করা","ex":"Please don't argue.","exbn":"দয়া করে তর্ক করো না।","d":"to speak angrily with someone who disagrees"},{"n":741,"w":"board","p":"noun","bn":"বোর্ড; (verb) ওঠা (যানবাহনে)","ex":"Write it on the board.","exbn":"বোর্ডে এটা লেখো।","d":"a flat surface for writing on in a classroom"},{"n":742,"w":"holiday","p":"noun","bn":"ছুটি","ex":"Friday is a holiday.","exbn":"শুক্রবার ছুটির দিন।","d":"a day when people don't work"},{"n":743,"w":"mark","p":"noun","bn":"দাগ; নম্বর (পরীক্ষার)","ex":"I got good marks in English.","exbn":"আমি ইংরেজিতে ভালো নম্বর পেয়েছি।","d":"a number or letter for your work at school"},{"n":744,"w":"church","p":"noun","bn":"গির্জা","ex":"There is an old church in the town.","exbn":"শহরে একটা পুরনো গির্জা আছে।","d":"a building where Christians pray"},{"n":745,"w":"machine","p":"noun","bn":"যন্ত্র, মেশিন","ex":"The washing machine is broken.","exbn":"ওয়াশিং মেশিনটা নষ্ট।","d":"a piece of equipment that does work"},{"n":746,"w":"achieve","p":"verb","bn":"অর্জন করা","ex":"You can achieve your goals.","exbn":"তুমি তোমার লক্ষ্য অর্জন করতে পারবে।","d":"to succeed in doing something"},{"n":747,"w":"item","p":"noun","bn":"জিনিস, আইটেম","ex":"How many items are in your bag?","exbn":"তোমার ব্যাগে কয়টা জিনিস আছে?","d":"a single thing"},{"n":748,"w":"prove","p":"verb","bn":"প্রমাণ করা","ex":"Can you prove it?","exbn":"তুমি কি এটা প্রমাণ করতে পারবে?","d":"to show that something is true"},{"n":749,"w":"cent","p":"noun","bn":"সেন্ট (ডলারের ভগ্নাংশ)","ex":"It costs ninety-nine cents.","exbn":"এটার দাম নিরানব্বই সেন্ট।","d":"a small coin; 100 cents = 1 dollar"},{"n":750,"w":"season","p":"noun","bn":"ঋতু, মৌসুম","ex":"Winter is my favorite season.","exbn":"শীত আমার প্রিয় ঋতু।","d":"spring, summer, autumn or winter"},{"n":751,"w":"floor","p":"noun","bn":"মেঝে; তলা","ex":"My office is on the fifth floor.","exbn":"আমার অফিস পাঁচ তলায়।","d":"a level of a building"},{"n":752,"w":"stuff","p":"noun","bn":"জিনিসপত্র (কথ্য)","ex":"Put your stuff in the car.","exbn":"তোমার জিনিসপত্র গাড়িতে রাখো।","d":"things (informal)"},{"n":753,"w":"wide","p":"adjective","bn":"চওড়া, প্রশস্ত","ex":"The river is very wide here.","exbn":"এখানে নদীটা খুব চওড়া।","d":"large from one side to the other"},{"n":754,"w":"anyone","p":"pronoun","bn":"কেউ, যে কেউ","ex":"Is anyone home?","exbn":"বাসায় কেউ আছে?","d":"any person"},{"n":755,"w":"method","p":"noun","bn":"পদ্ধতি","ex":"This is a good method for learning words.","exbn":"শব্দ শেখার জন্য এটা একটা ভালো পদ্ধতি।","d":"a way of doing something"},{"n":756,"w":"analysis","p":"noun","bn":"বিশ্লেষণ","ex":"The report has a detailed analysis.","exbn":"রিপোর্টে বিস্তারিত বিশ্লেষণ আছে।","d":"a careful study of something"},{"n":757,"w":"election","p":"noun","bn":"নির্বাচন","ex":"The election is next month.","exbn":"নির্বাচন আগামী মাসে।","d":"a time when people vote to choose leaders"},{"n":758,"w":"military","p":"adjective","bn":"সামরিক","ex":"He joined the military.","exbn":"সে সেনাবাহিনীতে যোগ দিয়েছে।","d":"the army and armed forces"},{"n":759,"w":"hotel","p":"noun","bn":"হোটেল","ex":"We stayed at a nice hotel.","exbn":"আমরা একটা ভালো হোটেলে ছিলাম।","d":"a building where you pay to stay"},{"n":760,"w":"club","p":"noun","bn":"ক্লাব","ex":"I joined a book club.","exbn":"আমি একটা বই পড়ার ক্লাবে যোগ দিয়েছি।","d":"a group of people with the same interest"},{"n":761,"w":"below","p":"preposition","bn":"নিচে","ex":"Write your answer below.","exbn":"নিচে তোমার উত্তর লেখো।","d":"under; lower than"},{"n":762,"w":"movie","p":"noun","bn":"সিনেমা","ex":"Let's watch a movie.","exbn":"চলো একটা সিনেমা দেখি।","d":"a film"},{"n":763,"w":"doctor","p":"noun","bn":"ডাক্তার","ex":"You should see a doctor.","exbn":"তোমার ডাক্তার দেখানো উচিত।","d":"a person who treats sick people"},{"n":764,"w":"discussion","p":"noun","bn":"আলোচনা","ex":"We had a long discussion.","exbn":"আমাদের লম্বা আলোচনা হয়েছে।","d":"a conversation about a topic"},{"n":765,"w":"sorry","p":"adjective","bn":"দুঃখিত","ex":"I'm sorry I'm late.","exbn":"দেরি করার জন্য দুঃখিত।","d":"used to apologise"},{"n":766,"w":"challenge","p":"noun","bn":"চ্যালেঞ্জ, কঠিন কাজ","ex":"Learning a language is a challenge.","exbn":"একটা ভাষা শেখা একটা চ্যালেঞ্জ।","d":"something difficult that tests you"},{"n":767,"w":"nation","p":"noun","bn":"জাতি, রাষ্ট্র","ex":"The whole nation celebrated.","exbn":"পুরো জাতি উদযাপন করেছে।","d":"a country and its people"},{"n":768,"w":"nearly","p":"adverb","bn":"প্রায়","ex":"It's nearly ten o'clock.","exbn":"প্রায় দশটা বাজে।","d":"almost"},{"n":769,"w":"statement","p":"noun","bn":"বিবৃতি; (bank statement) হিসাবের বিবরণী","ex":"I need my bank statement.","exbn":"আমার ব্যাংক স্টেটমেন্ট দরকার।","d":"a document showing money in your account"},{"n":770,"w":"link","p":"noun","bn":"লিংক, সংযোগ","ex":"Click on this link.","exbn":"এই লিংকে ক্লিক করো।","d":"text you click to go to a web page"},{"n":771,"w":"despite","p":"preposition","bn":"সত্ত্বেও","ex":"Despite the rain, we went out.","exbn":"বৃষ্টি সত্ত্বেও আমরা বাইরে গেলাম।","d":"even though there is something"},{"n":772,"w":"introduce","p":"verb","bn":"পরিচয় করিয়ে দেওয়া","ex":"Let me introduce my friend.","exbn":"আমার বন্ধুর সাথে পরিচয় করিয়ে দিই।","d":"to tell people each other's names"},{"n":773,"w":"advantage","p":"noun","bn":"সুবিধা","ex":"What are the advantages of this plan?","exbn":"এই পরিকল্পনার সুবিধাগুলো কী?","d":"something that helps you"},{"n":774,"w":"ready","p":"adjective","bn":"তৈরি, প্রস্তুত","ex":"Dinner is ready.","exbn":"রাতের খাবার তৈরি।","d":"prepared"},{"n":775,"w":"marry","p":"verb","bn":"বিয়ে করা","ex":"They will marry next year.","exbn":"তারা আগামী বছর বিয়ে করবে।","d":"to become husband and wife"},{"n":776,"w":"strike","p":"noun","bn":"ধর্মঘট; (verb) আঘাত করা","ex":"There is a bus strike today.","exbn":"আজ বাস ধর্মঘট চলছে।","d":"a time when workers stop working as a protest"},{"n":777,"w":"mile","p":"noun","bn":"মাইল","ex":"The beach is two miles away.","exbn":"সৈকতটা দুই মাইল দূরে।","d":"a distance of about 1.6 kilometres"},{"n":778,"w":"seek","p":"verb","bn":"খোঁজা, চাওয়া","ex":"You should seek advice from a lawyer.","exbn":"তোমার একজন আইনজীবীর পরামর্শ নেওয়া উচিত।","d":"to try to get something"},{"n":779,"w":"ability","p":"noun","bn":"সামর্থ্য, ক্ষমতা","ex":"She has the ability to lead.","exbn":"তার নেতৃত্ব দেওয়ার ক্ষমতা আছে।","d":"the skill or power to do something"},{"n":780,"w":"unit","p":"noun","bn":"একক, ইউনিট","ex":"Read unit three for homework.","exbn":"বাড়ির কাজের জন্য তৃতীয় ইউনিটটা পড়ো।","d":"one part of a course book"},{"n":781,"w":"card","p":"noun","bn":"কার্ড","ex":"Can I pay by card?","exbn":"আমি কি কার্ডে পেমেন্ট করতে পারি?","d":"a plastic bank card for paying"},{"n":782,"w":"hospital","p":"noun","bn":"হাসপাতাল","ex":"She works in a hospital.","exbn":"সে একটা হাসপাতালে কাজ করে।","d":"a place where sick people are treated"},{"n":783,"w":"quickly","p":"adverb","bn":"দ্রুত, তাড়াতাড়ি","ex":"Come here quickly!","exbn":"তাড়াতাড়ি এখানে আসো!","d":"fast"},{"n":784,"w":"interview","p":"noun","bn":"সাক্ষাৎকার, ইন্টারভিউ","ex":"I have a job interview tomorrow.","exbn":"কাল আমার চাকরির ইন্টারভিউ।","d":"a meeting where you are asked questions for a job"},{"n":785,"w":"agreement","p":"noun","bn":"চুক্তি; একমত হওয়া","ex":"We reached an agreement.","exbn":"আমরা একটা সমঝোতায় পৌঁছেছি।","d":"a decision people make together"},{"n":786,"w":"release","p":"verb","bn":"মুক্তি দেওয়া; প্রকাশ করা","ex":"The new film will release on Friday.","exbn":"নতুন সিনেমাটা শুক্রবার মুক্তি পাবে।","d":"to make a film or product available to the public"},{"n":787,"w":"tax","p":"noun","bn":"কর, ট্যাক্স","ex":"Everyone must pay tax.","exbn":"সবাইকে কর দিতে হবে।","d":"money people
[{"n":301,"w":"control","p":"verb","bn":"নিয়ন্ত্রণ করা","ex":"Try to control your anger.","exbn":"রাগ নিয়ন্ত্রণ করার চেষ্টা করো।","d":"to make something do what you want"},{"n":302,"w":"already","p":"adverb","bn":"ইতিমধ্যে, আগেই","ex":"I have already eaten.","exbn":"আমি আগেই খেয়ে নিয়েছি।","d":"before now"},{"n":303,"w":"concern","p":"noun","bn":"দুশ্চিন্তা, উদ্বেগ","ex":"My main concern is your health.","exbn":"আমার মূল দুশ্চিন্তা তোমার স্বাস্থ্য নিয়ে।","d":"a worry"},{"n":304,"w":"product","p":"noun","bn":"পণ্য","ex":"This product is made in Bangladesh.","exbn":"এই পণ্যটা বাংলাদেশে তৈরি।","d":"something made to be sold"},{"n":305,"w":"lose","p":"verb","bn":"হারানো; হেরে যাওয়া","ex":"Don't lose your ticket.","exbn":"তোমার টিকিটটা হারিয়ো না।","d":"to not be able to find something"},{"n":306,"w":"story","p":"noun","bn":"গল্প","ex":"My grandmother tells me a story every night.","exbn":"আমার নানি প্রতি রাতে আমাকে একটা গল্প বলেন।","d":"a description of events, real or imagined"},{"n":307,"w":"almost","p":"adverb","bn":"প্রায়","ex":"I am almost ready.","exbn":"আমি প্রায় তৈরি।","d":"nearly"},{"n":308,"w":"continue","p":"verb","bn":"চালিয়ে যাওয়া","ex":"Please continue your work.","exbn":"দয়া করে তোমার কাজ চালিয়ে যাও।","d":"to keep doing something"},{"n":309,"w":"stand","p":"verb","bn":"দাঁড়ানো","ex":"Please stand in the line.","exbn":"দয়া করে লাইনে দাঁড়ান।","d":"to be on your feet"},{"n":310,"w":"whole","p":"adjective","bn":"পুরো, সম্পূর্ণ","ex":"I ate the whole pizza.","exbn":"আমি পুরো পিৎজাটা খেয়ে ফেলেছি।","d":"all of something"},{"n":311,"w":"yet","p":"adverb","bn":"এখনো (না)","ex":"I haven't finished yet.","exbn":"আমি এখনো শেষ করিনি।","d":"until now (in negatives and questions)"},{"n":312,"w":"rate","p":"noun","bn":"হার, রেট","ex":"What is the exchange rate today?","exbn":"আজকের এক্সচেঞ্জ রেট কত?","d":"the value of one money compared to another"},{"n":313,"w":"care","p":"verb","bn":"যত্ন নেওয়া; (care about) গুরুত্ব দেওয়া","ex":"Take care of yourself.","exbn":"নিজের যত্ন নিও।","d":"take care of = look after"},{"n":314,"w":"expect","p":"verb","bn":"আশা করা, প্রত্যাশা করা","ex":"I expect him to call today.","exbn":"আমি আশা করছি সে আজ ফোন করবে।","d":"to think something will happen"},{"n":315,"w":"effect","p":"noun","bn":"প্রভাব, ফল","ex":"The medicine had a good effect.","exbn":"ওষুধটা ভালো কাজ করেছে।","d":"a change caused by something"},{"n":316,"w":"sort","p":"noun","bn":"ধরন; (verb) সাজানো","ex":"What sort of food do you like?","exbn":"তুমি কোন ধরনের খাবার পছন্দ করো?","d":"a type or kind"},{"n":317,"w":"ever","p":"adverb","bn":"কখনো (প্রশ্নে)","ex":"Have you ever been to Cox's Bazar?","exbn":"তুমি কি কখনো কক্সবাজার গিয়েছ?","d":"at any time"},{"n":318,"w":"anything","p":"pronoun","bn":"কিছু, যেকোনো কিছু","ex":"Do you need anything?","exbn":"তোমার কি কিছু লাগবে?","d":"any thing at all"},{"n":319,"w":"cause","p":"verb","bn":"ঘটানো, কারণ হওয়া","ex":"Heavy rain caused the flood.","exbn":"ভারী বৃষ্টির কারণে বন্যা হয়েছে।","d":"to make something happen"},{"n":320,"w":"fall","p":"verb","bn":"পড়ে যাওয়া","ex":"Be careful, don't fall.","exbn":"সাবধান, পড়ে যেও না।","d":"to drop down to the ground"},{"n":321,"w":"deal","p":"noun","bn":"চুক্তি; সুবিধাজনক দাম","ex":"We made a deal.","exbn":"আমরা একটা চুক্তি করেছি।","d":"an agreement"},{"n":322,"w":"water","p":"noun","bn":"পানি","ex":"Can I have a glass of water?","exbn":"আমাকে এক গ্লাস পানি দেবেন?","d":"the clear liquid we drink"},{"n":323,"w":"send","p":"verb","bn":"পাঠানো","ex":"I will send you the file.","exbn":"আমি তোমাকে ফাইলটা পাঠিয়ে দেব।","d":"to make something go to someone"},{"n":324,"w":"allow","p":"verb","bn":"অনুমতি দেওয়া","ex":"Phones are not allowed in the exam.","exbn":"পরীক্ষায় ফোন নেওয়ার অনুমতি নেই।","d":"to let someone do something"},{"n":325,"w":"soon","p":"adverb","bn":"শিগগিরই","ex":"See you soon.","exbn":"শিগগিরই দেখা হবে।","d":"in a short time"},{"n":326,"w":"watch","p":"verb","bn":"দেখা (মনোযোগ দিয়ে)","ex":"We watch TV after dinner.","exbn":"আমরা রাতের খাবারের পর টিভি দেখি।","d":"to look at something for some time"},{"n":327,"w":"base","p":"noun","bn":"ভিত্তি; ঘাঁটি","ex":"Our company's base is in Dhaka.","exbn":"আমাদের কোম্পানির মূল অফিস ঢাকায়।","d":"the main place where a company works"},{"n":328,"w":"probably","p":"adverb","bn":"সম্ভবত","ex":"He will probably come late.","exbn":"সে সম্ভবত দেরিতে আসবে।","d":"very likely"},{"n":329,"w":"suggest","p":"verb","bn":"পরামর্শ দেওয়া","ex":"I suggest you take a rest.","exbn":"আমার পরামর্শ, তুমি একটু বিশ্রাম নাও।","d":"to give an idea or advice"},{"n":330,"w":"past","p":"noun","bn":"অতীত; (preposition) পেরিয়ে","ex":"Forget the past.","exbn":"অতীত ভুলে যাও।","d":"the time before now"},{"n":331,"w":"power","p":"noun","bn":"ক্ষমতা; বিদ্যুৎ","ex":"The power went out last night.","exbn":"কাল রাতে কারেন্ট চলে গিয়েছিল।","d":"electricity"},{"n":332,"w":"test","p":"noun","bn":"পরীক্ষা","ex":"I have a math test tomorrow.","exbn":"কাল আমার গণিত পরীক্ষা।","d":"a set of questions to check what you know"},{"n":333,"w":"visit","p":"verb","bn":"দেখা করতে যাওয়া, বেড়াতে যাওয়া","ex":"I will visit my aunt this weekend.","exbn":"এই সপ্তাহান্তে আমি খালার বাসায় বেড়াতে যাব।","d":"to go and see a person or place"},{"n":334,"w":"center","p":"noun","bn":"কেন্দ্র, মাঝখান","ex":"The hotel is in the center of the city.","exbn":"হোটেলটা শহরের মাঝখানে।","d":"the middle part"},{"n":335,"w":"grow","p":"verb","bn":"বড় হওয়া; চাষ করা","ex":"My father grows rice.","exbn":"আমার বাবা ধান চাষ করেন।","d":"to make plants get bigger"},{"n":336,"w":"nothing","p":"pronoun","bn":"কিছুই না","ex":"There is nothing in the box.","exbn":"বাক্সে কিছুই নেই।","d":"not anything"},{"n":337,"w":"return","p":"verb","bn":"ফিরে আসা; ফেরত দেওয়া","ex":"I will return the book tomorrow.","exbn":"আমি কাল বইটা ফেরত দেব।","d":"to give something back"},{"n":338,"w":"mother","p":"noun","bn":"মা","ex":"My mother is a teacher.","exbn":"আমার মা একজন শিক্ষক।","d":"your female parent"},{"n":339,"w":"walk","p":"verb","bn":"হাঁটা","ex":"I walk to work.","exbn":"আমি হেঁটে কাজে যাই।","d":"to move on foot"},{"n":340,"w":"matter","p":"verb","bn":"গুরুত্বপূর্ণ হওয়া; (noun) বিষয়","ex":"It doesn't matter.","exbn":"এতে কিছু যায় আসে না।","d":"to be important"},{"n":341,"w":"mind","p":"noun","bn":"মন; (verb) আপত্তি করা","ex":"Do you mind if I sit here?","exbn":"আমি এখানে বসলে কি আপনার আপত্তি আছে?","d":"do you mind = is it a problem for you"},{"n":342,"w":"value","p":"noun","bn":"মূল্য","ex":"Your time has great value.","exbn":"তোমার সময়ের অনেক মূল্য।","d":"how important or useful something is"},{"n":343,"w":"office","p":"noun","bn":"অফিস","ex":"I go to the office at nine.","exbn":"আমি নয়টায় অফিসে যাই।","d":"a room or building where people work at desks"},{"n":344,"w":"record","p":"verb","bn":"রেকর্ড করা","ex":"Record your voice and listen.","exbn":"তোমার কণ্ঠ রেকর্ড করে শোনো।","d":"to save sound or video"},{"n":345,"w":"stay","p":"verb","bn":"থাকা","ex":"I will stay at a hotel.","exbn":"আমি একটা হোটেলে থাকব।","d":"to live in a place for a short time"},{"n":346,"w":"force","p":"verb","bn":"জোর করা","ex":"Don't force him to eat.","exbn":"তাকে খেতে জোর করো না।","d":"to make someone do something they don't want to"},{"n":347,"w":"stop","p":"verb","bn":"থামা, বন্ধ করা","ex":"Please stop the car here.","exbn":"দয়া করে গাড়িটা এখানে থামান।","d":"to make something not move"},{"n":348,"w":"several","p":"determiner","bn":"বেশ কয়েকটা","ex":"I called him several times.","exbn":"আমি তাকে বেশ কয়েকবার ফোন করেছি।","d":"more than two but not many"},{"n":349,"w":"light","p":"noun","bn":"আলো; (adjective) হালকা","ex":"Turn on the light, please.","exbn":"দয়া করে লাইটটা জ্বালাও।","d":"the brightness from a lamp or the sun"},{"n":350,"w":"develop","p":"verb","bn":"উন্নত করা, গড়ে তোলা","ex":"I want to develop my skills.","exbn":"আমি আমার দক্ষতা বাড়াতে চাই।","d":"to grow or make better"},{"n":351,"w":"remember","p":"verb","bn":"মনে রাখা, মনে পড়া","ex":"I remember your name.","exbn":"তোমার নাম আমার মনে আছে।","d":"to keep something in your mind"},{"n":352,"w":"bit","p":"noun","bn":"একটু (a bit)","ex":"I am a bit tired.","exbn":"আমি একটু ক্লান্ত।","d":"a little (a bit = slightly)"},{"n":353,"w":"share","p":"verb","bn":"ভাগ করে নেওয়া, শেয়ার করা","ex":"Let's share this cake.","exbn":"চলো কেকটা ভাগ করে খাই।","d":"to divide and give some to others"},{"n":354,"w":"real","p":"adjective","bn":"আসল, বাস্তব","ex":"Is this a real diamond?","exbn":"এটা কি আসল হীরা?","d":"true; not fake"},{"n":355,"w":"answer","p":"noun","bn":"উত্তর; (verb) উত্তর দেওয়া","ex":"I know the answer.","exbn":"আমি উত্তরটা জানি।","d":"what you say or write in reply"},{"n":356,"w":"sit","p":"verb","bn":"বসা","ex":"Please sit here.","exbn":"দয়া করে এখানে বসুন।","d":"to rest on a chair or seat"},{"n":357,"w":"figure","p":"verb","bn":"সংখ্যা; আকৃতি; (figure out) বুঝে বের করা","ex":"I can't figure out this problem.","exbn":"এই সমস্যাটা আমি বুঝে উঠতে পারছি না।","d":"figure out = to understand or solve"},{"n":358,"w":"letter","p":"noun","bn":"চিঠি; অক্ষর","ex":"I wrote a letter to my friend.","exbn":"আমি বন্ধুকে একটা চিঠি লিখেছি।","d":"a written message sent to someone"},{"n":359,"w":"decide","p":"verb","bn":"সিদ্ধান্ত নেওয়া","ex":"I decided to learn English.","exbn":"আমি ইংরেজি শেখার সিদ্ধান্ত নিয়েছি।","d":"to make a choice"},{"n":360,"w":"language","p":"noun","bn":"ভাষা","ex":"Bangla is my first language.","exbn":"বাংলা আমার মাতৃভাষা।","d":"words used by people of a country"},{"n":361,"w":"subject","p":"noun","bn":"বিষয়","ex":"Math is my favorite subject.","exbn":"গণিত আমার প্রিয় বিষয়।","d":"an area of study at school"},{"n":362,"w":"class","p":"noun","bn":"ক্লাস, শ্রেণি","ex":"Our class starts at ten.","exbn":"আমাদের ক্লাস দশটায় শুরু হয়।","d":"a group of students or a lesson"},{"n":363,"w":"development","p":"noun","bn":"উন্নয়ন","ex":"The city needs more development.","exbn":"শহরের আরও উন্নয়ন দরকার।","d":"growth and improvement"},{"n":364,"w":"town","p":"noun","bn":"শহর (ছোট)","ex":"I grew up in a small town.","exbn":"আমি একটা ছোট শহরে বড় হয়েছি।","d":"a place with houses and shops, smaller than a city"},{"n":365,"w":"half","p":"noun","bn":"অর্ধেক","ex":"Give me half of the cake.","exbn":"কেকের অর্ধেকটা আমাকে দাও।","d":"one of two equal parts"},{"n":366,"w":"minute","p":"noun","bn":"মিনিট","ex":"Wait a minute, please.","exbn":"এক মিনিট অপেক্ষা করুন।","d":"sixty seconds"},{"n":367,"w":"food","p":"noun","bn":"খাবার","ex":"The food here is delicious.","exbn":"এখানকার খাবার খুব মজার।","d":"what people and animals eat"},{"n":368,"w":"break","p":"verb","bn":"ভাঙা; (noun) বিরতি","ex":"Let's take a short break.","exbn":"চলো একটু বিরতি নিই।","d":"a short rest"},{"n":369,"w":"clear","p":"adjective","bn":"পরিষ্কার, স্পষ্ট","ex":"Is that clear?","exbn":"ব্যাপারটা কি পরিষ্কার?","d":"easy to understand"},{"n":370,"w":"future","p":"noun","bn":"ভবিষ্যৎ","ex":"What are your plans for the future?","exbn":"ভবিষ্যতের জন্য তোমার পরিকল্পনা কী?","d":"the time after now"},{"n":371,"w":"either","p":"determiner","bn":"দুটোর যেকোনো একটা","ex":"You can take either bus.","exbn":"তুমি দুটোর যেকোনো বাসে উঠতে পারো।","d":"one or the other of two"},{"n":372,"w":"ago","p":"adverb","bn":"আগে (সময়)","ex":"I came here two years ago.","exbn":"আমি দুই বছর আগে এখানে এসেছি।","d":"back in time from now (two years ago)"},{"n":373,"w":"per","p":"preposition","bn":"প্রতি","ex":"The rent is ten thousand taka per month.","exbn":"ভাড়া মাসে দশ হাজার টাকা।","d":"for each"},{"n":374,"w":"remain","p":"verb","bn":"থেকে যাওয়া, রয়ে যাওয়া","ex":"Please remain in your seats.","exbn":"দয়া করে নিজের আসনে বসে থাকুন।","d":"to stay in the same place"},{"n":375,"w":"top","p":"noun","bn":"উপরের অংশ, চূড়া","ex":"Write your name at the top.","exbn":"উপরে তোমার নাম লেখো।","d":"the highest part"},{"n":376,"w":"among","p":"preposition","bn":"মধ্যে (অনেকের)","ex":"She is popular among students.","exbn":"ছাত্রছাত্রীদের মধ্যে সে জনপ্রিয়।","d":"in a group of people or things"},{"n":377,"w":"win","p":"verb","bn":"জেতা","ex":"I hope our team wins.","exbn":"আশা করি আমাদের দল জিতবে।","d":"to come first in a game or competition"},{"n":378,"w":"color","p":"noun","bn":"রং","ex":"My favorite color is blue.","exbn":"আমার প্রিয় রং নীল।","d":"red, blue, green and so on"},{"n":379,"w":"involve","p":"verb","bn":"জড়িত থাকা, যুক্ত করা","ex":"The job involves a lot of travel.","exbn":"এই কাজে অনেক ভ্রমণ করতে হয়।","d":"to include as a necessary part"},{"n":380,"w":"reach","p":"verb","bn":"পৌঁছানো","ex":"We reached home at midnight.","exbn":"আমরা মাঝরাতে বাসায় পৌঁছেছি।","d":"to arrive at a place"},{"n":381,"w":"social","p":"adjective","bn":"সামাজিক","ex":"I don't use social media much.","exbn":"আমি সোশ্যাল মিডিয়া বেশি ব্যবহার করি না।","d":"about people and their relationships"},{"n":382,"w":"period","p":"noun","bn":"সময়কাল","ex":"The offer is for a short period.","exbn":"অফারটা অল্প সময়ের জন্য।","d":"a length of time"},{"n":383,"w":"across","p":"preposition","bn":"পার হয়ে, ওপারে","ex":"The shop is across the road.","exbn":"দোকানটা রাস্তার ওপারে।","d":"on the other side of"},{"n":384,"w":"note","p":"noun","bn":"নোট, ছোট লেখা","ex":"I left a note on the table.","exbn":"আমি টেবিলে একটা নোট রেখে এসেছি।","d":"a short written message"},{"n":385,"w":"history","p":"noun","bn":"ইতিহাস","ex":"I love reading history books.","exbn":"আমি ইতিহাসের বই পড়তে ভালোবাসি।","d":"the study of past events"},{"n":386,"w":"create","p":"verb","bn":"তৈরি করা","ex":"She creates beautiful designs.","exbn":"সে সুন্দর ডিজাইন তৈরি করে।","d":"to make something new"},{"n":387,"w":"drive","p":"verb","bn":"গাড়ি চালানো","ex":"Can you drive?","exbn":"তুমি কি গাড়ি চালাতে পারো?","d":"to make a car move"},{"n":388,"w":"along","p":"preposition","bn":"বরাবর, ধরে","ex":"We walked along the river.","exbn":"আমরা নদীর পাড় ধরে হাঁটলাম।","d":"from one end towards the other"},{"n":389,"w":"type","p":"noun","bn":"ধরন; (verb) টাইপ করা","ex":"What type of phone do you have?","exbn":"তোমার কোন ধরনের ফোন?","d":"a kind or sort"},{"n":390,"w":"sound","p":"verb","bn":"শব্দ, আওয়াজ; (verb) শোনানো","ex":"That sounds good!","exbn":"শুনে ভালো লাগছে!","d":"to seem, from what you hear or read"},{"n":391,"w":"eye","p":"noun","bn":"চোখ","ex":"She has big brown eyes.","exbn":"তার বড় বড় বাদামি চোখ।","d":"the part of your face you see with"},{"n":392,"w":"music","p":"noun","bn":"গান, সংগীত","ex":"I listen to music every day.","exbn":"আমি প্রতিদিন গান শুনি।","d":"sounds made by singing or playing instruments"},{"n":393,"w":"game","p":"noun","bn":"খেলা","ex":"Let's play a game.","exbn":"চলো একটা খেলা খেলি।","d":"an activity with rules that you play for fun"},{"n":394,"w":"political","p":"adjective","bn":"রাজনৈতিক","ex":"They talked about political news.","exbn":"তারা রাজনৈতিক খবর নিয়ে কথা বলল।","d":"about government and politics"},{"n":395,"w":"free","p":"adjective","bn":"ফ্রি, বিনামূল্যে; অবসর","ex":"Are you free tomorrow?","exbn":"তুমি কি কাল ফ্রি আছো?","d":"not busy"},{"n":396,"w":"receive","p":"verb","bn":"পাওয়া, গ্রহণ করা","ex":"Did you receive my email?","exbn":"তুমি কি আমার ইমেইল পেয়েছ?","d":"to get something that is sent"},{"n":397,"w":"moment","p":"noun","bn":"মুহূর্ত","ex":"Please wait a moment.","exbn":"দয়া করে এক মুহূর্ত অপেক্ষা করুন।","d":"a very short time"},{"n":398,"w":"sale","p":"noun","bn":"বিক্রি; সেল (ছাড়)","ex":"The shop has a big sale this week.","exbn":"এই সপ্তাহে দোকানে বড় সেল চলছে।","d":"a time when a shop sells things cheaper"},{"n":399,"w":"policy","p":"noun","bn":"নীতি, নিয়ম","ex":"The company has a new policy.","exbn":"কোম্পানির একটা নতুন নিয়ম হয়েছে।","d":"a rule or plan of an organisation"},{"n":400,"w":"further","p":"adverb","bn":"আরও; আরও দূরে","ex":"Do you have any further questions?","exbn":"আপনার কি আর কোনো প্রশ্ন আছে?","d":"more; extra"}]